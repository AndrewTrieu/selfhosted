# Where persistent data lives. /tank/services is the ZFS layout this repo was built on.
# Any folder works without ZFS (create it, then follow "Setting up without ZFS" in the README).
HOMELAB_DATA=/tank/services
# Time zone for the containers, e.g. Europe/London
HOMELAB_TZ=UTC
# Name shown in the Forgejo UI
HOMELAB_FORGEJO_NAME=Forgejo
# Where the bare root domain redirects to (ROOT_DOMAIN). Any URL works.
ROOT_REDIRECT_URL=https://example.com/
# Optional stacks to start, comma-separated: auth, ci, monitoring, matter, home.
# auth and monitoring start by default. ci runs the CI runner on this host: do not use it here.
# home (Home Assistant) and matter need extra setup; see the README.
COMPOSE_PROFILES=auth,monitoring

# Domain Settings
ROOT_DOMAIN=example.com
VAULT_DOMAIN=vault.example.com
TWOFAUTH_DOMAIN=2fa.example.com
STORAGE_DOMAIN=cloud.example.com
WG_DOMAIN=wg.example.com
GIT_DOMAIN=git.example.com
DNS_DOMAIN=dns.example.com
XUI_DOMAIN=xui.example.com
REALITY_DOMAIN=reality.example.com
AIRTRAIL_DOMAIN=flights.example.com
HA_DOMAIN=home.example.com

# General Settings
EMAIL=mail@example.com

# Application Keys & Secrets
TWOFAUTH_APP_KEY=your_2fauth_app_secret_key

# Passwords & Hashes
WG_EASY_PASSWORD_HASH=your_bcrypt_hashed_password
FORGEJO_DB_PASSWORD=your_forgejo_database_password
AIRTRAIL_DB_PASSWORD=your_airtrail_database_password
HAMH_HTTP_PASSWORD=your_matter_hub_web_ui_password

# API & Integration Tokens
CF_API_TOKEN=your_cloudflare_api_token
CF_TUNNEL_TOKEN=your_cloudflare_tunnel_token
CROWDSEC_API_KEY=your_crowdsec_api_key
AIRTRAIL_AERO_DATA_BOX_KEY=your_aero_data_box_key
AIRTRAIL_OPEN_AIP_KEY=your_open_aip_key
HAMH_HA_TOKEN=your_home_assistant_long_lived_access_token


# Only needed if stacks/auth.yml (Authentik) is selected
# AUTH_DOMAIN=auth.example.com
# AUTHENTIK_SECRET_KEY=your_authentik_secret_key
# AUTHENTIK_DB_PASSWORD=your_authentik_database_password

# Only needed if stacks/matter.yml (Matter controller + Thread) is selected
# Dongle-M address and port; prefer a fixed IP (DHCP reservation) over dongle-m.local
# OTBR_NETWORK_DEVICE=192.168.1.50:6638

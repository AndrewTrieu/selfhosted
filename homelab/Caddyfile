{
    order crowdsec first

    crowdsec {
        api_url http://crowdsec:8080
        api_key {env.CROWDSEC_API_KEY}
    }

    servers {
        trusted_proxies cloudflare
    }
}

(sec_headers) {
    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    }
}

(dns_cf) {
    tls {
        dns cloudflare {env.CF_API_TOKEN}
    }
    log {
        output file {env.LOG_FILE}
        format json
    }
}

(common_config) {
    import sec_headers
    import dns_cf
    crowdsec
    encode gzip zstd
}

{env.VAULT_DOMAIN} {
    import common_config
    reverse_proxy vaultwarden:80
}

{env.TWOFAUTH_DOMAIN} {
    import common_config
    reverse_proxy 2fauth:8000
}

{env.STORAGE_DOMAIN} {
    import common_config
    reverse_proxy filebrowser:80
}

{env.GIT_DOMAIN} {
    import common_config
    reverse_proxy forgejo:3000
}

{env.DNS_DOMAIN} {
    import common_config
    reverse_proxy adguard:3000
}

{env.AIRTRAIL_DOMAIN} {
    import common_config
    reverse_proxy airtrail:3000
}

{env.HA_DOMAIN} {
    import common_config
    reverse_proxy host.docker.internal:8123
}

{env.XUI_DOMAIN} {
    import sec_headers
    import dns_cf
    encode zstd gzip

    # ---- X-UI admin panel ----
    route /admin* {
        crowdsec
        reverse_proxy host.docker.internal:2053
    }

    # ---- VLESS WebSocket ----
    route /ws* {
        @websockets {
            header Connection *Upgrade*
            header Upgrade websocket
        }
        reverse_proxy @websockets host.docker.internal:10000
        respond 403
    }

    respond 404
}



{env.ROOT_DOMAIN} {
    import sec_headers
    import dns_cf
    encode zstd gzip

    redir {env.ROOT_REDIRECT_URL}
}



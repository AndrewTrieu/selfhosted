# Copy to backend.hcl (gitignored) and fill in. Use: terraform init -backend-config=backend.hcl
# Access keys come from the environment, not this file:
#   export AWS_ACCESS_KEY_ID=...        # R2 access key ID
#   export AWS_SECRET_ACCESS_KEY=...    # R2 secret access key
bucket                      = "REPLACE_R2_BUCKET"
key                         = "homelab/cloudflare.tfstate"
region                      = "auto"
endpoints = { s3 = "https://REPLACE_ACCOUNT_ID.r2.cloudflarestorage.com" }
skip_credentials_validation = true
skip_region_validation      = true
skip_requesting_account_id  = true
skip_metadata_api_check     = true
skip_s3_checksum            = true
use_path_style              = true
